---
// ============================================================
// PostCard.astro —— 首页上的单张文章卡片
//
// 这是 S3 的第二个抽象：把「一张卡片长什么样」抽成一个组件。
//
// 对比 S2 的做法：那时卡片是一段模板字符串拼出来的 HTML，
// 写在 posts.js 里，字符串中间还有 ${} 插值，很难看清最终结构。
// 现在它就是一段 HTML，变量用 {} 直接写，和写普通页面没区别。
//
// 另一个变化：组件化之后，想改卡片样式或结构，只改这一个文件。
// ============================================================

// CollectionEntry<'posts'> 是 Astro 给内容条目自动生成的类型。
// 它保证 post.data 下面一定有 title / description / pubDate 这些字段——
// 因为 content.config.ts 里的 schema 是这么声明的。
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;

// 从数据里取字段。post.id 来自文件名（01-html-basics.md → 01-html-basics），
// post.data 是 Front Matter 解析后的对象。
const { title, description, pubDate } = post.data;

// 日期格式化成 YYYY-MM-DD。
// Front Matter 里写的是 2026-10-04，经过 schema 的 z.coerce.date() 之后
// 已经是一个 Date 对象，这里把它重新格式化成便于阅读的字符串。
const dateText = pubDate.toISOString().slice(0, 10);
---

{/*
  href 里用 post.id 拼出文章地址，也就是 /posts/01-html-basics/。
  S2 时这里是 post.html?id=01-html-basics（靠查询参数在客户端找文章），
  S3 是 /posts/01-html-basics/（构建时就生成的真实页面）。
  后者对搜索引擎和分享链接都更友好。
*/}
<a class="post-card" href={`/posts/${post.id}/`}>
  <h3>{title}</h3>
  <p class="muted">{description}</p>
  {/* <time> 是语义化标签：告诉浏览器和读屏软件"这是时间"。
       datetime 属性用机器可读的格式，标签里的文字给人看。 */}
  <time datetime={dateText}>{dateText}</time>
</a>
