---
// ============================================================
// src/pages/posts/[id].astro —— 文章详情页
//
// 文件名里的方括号表示「动态路由」：它不是一个固定地址，
// 而是一个模板，会被套用若干次，每次生成一个不同的页面。
//
// 这是 S3 里最需要想明白的一个机制，所以拆开讲。
//
// 【问题】我不知道文章会有几篇，也不想为每一篇手写一个页面文件。
//        那要怎样让 N 篇文章各自拥有一个真实存在的 HTML 文件？
//
// 【答案】两条信息：
//   1. getStaticPaths() 告诉 Astro「一共有哪些 id，每篇对应的数据是什么」
//   2. 构建时 Astro 拿着这份清单，把这个模板跑 N 遍
//
// 【和 S2 的对比】
//   S2：只有 post.html 一个文件，靠 ?id=xxx 在后面挂参数区分文章。
//       服务器永远只返回同一个文件，是 JS 在浏览器里换了内容。
//   S3：构建出 N 个独立文件，/posts/html-basics/index.html、
//       /posts/css-layout/index.html……每个 URL 都对应真实存在的文件。
// ============================================================

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// getStaticPaths 是给构建器看的「清单」，它不会出现在任何页面里。
// 返回的每一项：params 决定生成哪个网址，props 决定那个页面拿到什么数据。
export async function getStaticPaths() {
  const posts = await getCollection('posts');

  return posts.map((post) => ({
    // post.id 来自文件名：html-basics.md → 'html-basics'
    // 于是这个模板会为它生成 /posts/html-basics/ 这个页面
    params: { id: post.id },
    // props 会原样传给下面的 Astro.props
    props: { post },
  }));
}

// getStaticPaths 里传下来的那篇文章
const { post } = Astro.props;

// render 把 Markdown 正文转成可渲染的组件。
// 注意这是 S3 最核心的一步：**转换发生在构建时**，
// 产物是 HTML 字符串，随页面一起送到浏览器，不需要客户端做任何事。
//
// 对比 S2：正文是以 HTML 字符串存在 JSON 里的，需要 fetch 回来再塞进 DOM。
const { Content } = await render(post);

const { title, description, pubDate, tags } = post.data;
const dateText = pubDate.toISOString().slice(0, 10);
---

<BaseLayout title={title} description={description}>
  {/* .prose 这个类负责长文排版（行距、段间距、代码块样式），
       它管的是下面 <Content /> 生成出来的那些标签 */}
  <article class="prose">
    <a class="back-link" href="/">← 返回文章列表</a>

    <div class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={dateText}>{dateText}</time>

        {/* 标签来自 Front Matter 的 tags 字段。
             注意这里先判断 tags.length > 0 再渲染，
             否则没写标签的文章会留下一个空的 <ul>。 */}
        {tags.length > 0 && (
          <ul class="post-tags">
            {tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )}
      </div>
    </div>

    {/*
      <Content /> 就是 Markdown 正文渲染出来的结果。
      下面这些写法：

          ## 一个小标题
          - 一项
          `一段行内代码`
          ```css
          一个代码块
          ```

      到这里会变成对应的 <h2>、<li>、<code>、<pre>。
      你写的是 Markdown，浏览器收到的是 HTML——转换发生在构建时。
    */}
    <Content />
  </article>
</BaseLayout>
